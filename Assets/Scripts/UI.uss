:root {
}

.unity-frame {
    justify-content: center;
    align-items: right;
    width: 100%;
    height: 100%;
    flex-wrap: wrap;
}

.image-position-background {
    width: auto;
    height: auto;
    background-color: rgba(60, 73, 82, 0.439);
    border-radius: 20px;
    justify-content: center;
    align-items: center;
    align-self: auto;
    align-content: auto;
    color: rgb(255, 255, 255);
    margin-bottom: 14px;
    padding-top: 30px;
    padding-right: 30px;
    padding-bottom: 30px;
    padding-left: 30px;
}

.section-title {
    color: rgb(255, 255, 255);
    text-align: center;
    font-size: 25px;
    align-items: auto;
    justify-content: flex-start;
    align-content: auto;
    align-self: center;
    -unity-font-style: bold;
    margin-bottom: 20px;
}

.progress-label-pair {
    align-items: center;
    align-content: auto;
    width: 100%;
    margin-top: 0;
    margin-right: 0%;
    margin-left: 0;
    padding-right: 51px;
    padding-left: 0;
    flex-direction: row;
    justify-content: flex-end;
}

.progress-label {
    font-size: 19px;
}

.unity-progress-bar__progress {
    background-color: rgb(41, 40, 255);
}
